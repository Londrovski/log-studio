{
  "name": "tbre-log-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Turn TBRe .mcap runs into watchable, shareable video, in Chrome.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs && npx --yes http-server dist -p 8080 -c-1",
    "deploy": "node build.mjs && wrangler deploy",
    "test": "node test/e2e.mjs"
  },
  "dependencies": {
    "@foxglove/wasm-zstd": "^1.0.1",
    "@mcap/core": "^2.1.7",
    "fzstd": "^0.1.1",
    "lz4js": "^0.2.0",
    "mediabunny": "^1.0.0",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.49.0",
    "wrangler": "^4.0.0"
  }
}
